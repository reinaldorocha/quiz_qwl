# Setup completo: veja SETUP.md (migrations sozinhas não bastam).

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App (deve bater com Site URL do Auth no Supabase)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Vercel (domínios personalizados)
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
# VERCEL_TEAM_ID=

# Billing (N8N → Supabase RPC via service role)
# - process_payment_webhook: confirma pagamento e ativa assinatura
# - process_payment_refund: registra reembolso e cancela assinatura
# - expire_overdue_subscriptions: cancela assinaturas vencidas há +2 dias
#   (pg_cron roda diariamente às 06:00 UTC; fallback N8N Schedule Trigger se necessário)

# Opcional: pular validação de env em CI/build
# SKIP_ENV_VALIDATION=true
